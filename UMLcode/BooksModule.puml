@startuml Books_Module_Django

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #1e1e2e
    BorderColor #89b4fa
    ArrowColor #cba6f7
    FontColor #cdd6f4
    AttributeFontColor #f38ba8
    StereotypeFontColor #a6e3a1
    HeaderBackgroundColor #313244
}
skinparam note {
    BackgroundColor #1e1e2e
    BorderColor #f38ba8
    FontColor #cdd6f4
}

note as AdminNote
  Admin flow:
  BookAdminView -> BookSerializer -> BookManager -> DB
end note

note as ViewNote
  View flow:
  BookListView -> BookSerializer -> BookQuerySet -> DB
end note

class BookAdminView {
    <<View>>
    +add_book(request) : Response
    +edit_book(request, id) : Response
    +delete_book(request, id) : Response
}

class BookListView {
    <<View>>
    +get_all_books(request) : Response
    +get_book_by_id(request, id) : Response
    +search_books(request) : Response
}

class BookSerializer {
    <<Serializer>>
    +title : CharField
    +author : CharField
    +genre : CharField
    +quantity : IntegerField
    +available : BooleanField
    +validate(data) : dict
    +create(validated_data) : Book
    +update(instance, validated_data) : Book
}

class IsAdminUser {
    <<Permission>>
    +has_permission(request, view) : bool
}

class IsAuthenticated {
    <<Permission>>
    +has_permission(request, view) : bool
}

class BookManager {
    <<Manager>>
    +get_available_books() : QuerySet
    +search_by_title(title) : QuerySet
    +search_by_author(author) : QuerySet
    +search_by_genre(genre) : QuerySet
}

class Book {
    <<Model>>
    -id : BigAutoField
    -title : CharField
    -author : CharField
    -genre : CharField
    -quantity : IntegerField
    -available : BooleanField
    +__str__() : str
    +is_available() : bool
}

enum Genre {
    FICTION
    NON_FICTION
    SCIENCE
    HISTORY
    TECHNOLOGY
    OTHER
}

BookAdminView --> BookSerializer : uses
BookAdminView --> IsAdminUser : protected by
BookListView --> BookSerializer : uses
BookListView --> IsAuthenticated : protected by
BookListView --> BookManager : queries via
BookSerializer --> BookManager : calls
BookManager --> Book : manages
Book --> Genre : has

@enduml